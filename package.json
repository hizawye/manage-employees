  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "cd android && ./gradlew assembleRelease",
"android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
     "android:clean": "cd android && ./gradlew clean",
     "android:logcat": "adb logcat -s ReactNativeJS:V AndroidRuntime:V *:S",
     "android:emulator": "./scripts/run-android.sh",
     "emulator": "./scripts/start-emulator.sh",
     "dev": "./scripts/dev-android.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~54.0.34",
    "expo-constants": "^18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.10",
    "expo-linking": "~8.0.12",
    "expo-localization": "^17.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "i18n-js": "^4.5.1",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-hook-form": "^7.71.0",
